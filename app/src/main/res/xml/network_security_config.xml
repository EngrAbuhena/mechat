<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext anywhere; system CAs only (RULE 2/5). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
