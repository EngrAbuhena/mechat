# Copy to .env and fill in. Never commit .env.
PORT=8080
MAX_BLOB_BYTES=262144
MAILBOX_TTL_MS=86400000
MAILBOX_TTL_MAX_MS=604800000
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_MS=1000

# Deployment (used by Caddyfile / docs/server.md)
SERVER_DOMAIN=example.org
TURN_REALM=example.org
TLS_CERT_DIR=/etc/letsencrypt/live/example.org
